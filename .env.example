# Datagarden Environment Variables

# Companies House (free, UK government)
# Register at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_key_here

# YouTube Data API (free, 10k units/day)
# Get from https://console.cloud.google.com
YOUTUBE_API_KEY=your_key_here

# Optional: Apify ($5/mo free credit for better eBay scraping)
# APIFY_TOKEN=your_token_here

# Optional: Jev — TypeSafe System One ($0.042/Mtok, output free)
# Get key at https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=your_key_here
